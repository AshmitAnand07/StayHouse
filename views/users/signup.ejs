<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="col-12 col-md-6 offset-md-3">Signup for Wanderlust</h1>
        <div class="col-12 col-md-6 offset-md-3">
            <form action="/signup" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" 
                        placeholder="enter username" 
                        id="username" 
                        type="text" 
                        class="form-control"
                        required />
                    <div class="valid-feedback">Username looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" 
                        placeholder="enter email" 
                        id="email" 
                        type="email" 
                        class="form-control"
                        required />
                    <div class="valid-feedback">Email looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" 
                        placeholder="enter password" 
                        id="password" 
                        type="password"
                        class="form-control" 
                        required />
                    <div class="valid-feedback">Password looks good!</div>
                </div>
                <button type="submit" class="btn btn-primary">Sign Up</button>
            </form>
        </div>
    </div>